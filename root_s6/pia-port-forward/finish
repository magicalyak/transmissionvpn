#!/command/with-contenv bash
# shellcheck shell=bash
# Cleanup script for PIA port forwarding service

log() {
  echo "[PIA-PF] $(date '+%Y-%m-%d %H:%M:%S') FINISH: $1"
}

log "PIA port forwarding service stopping"

# Kill the keepalive background process
if [ -f /tmp/pia_keepalive_pid ]; then
  KEEPALIVE_PID=$(cat /tmp/pia_keepalive_pid)
  if kill -0 "$KEEPALIVE_PID" 2>/dev/null; then
    kill "$KEEPALIVE_PID" 2>/dev/null || true
    log "Stopped keepalive process (PID $KEEPALIVE_PID)"
  fi
  rm -f /tmp/pia_keepalive_pid
fi

# Remove iptables rules for the forwarded port.
# Delegated to the shared helper so the rules removed here always match the
# rules installed by pia-pf-firewall.sh apply.
#
# NOTE: pia-port-forward is registered as an s6-rc *oneshot* (see the Dockerfile),
# and oneshots use up/down rather than run/finish, so s6 never executes this
# script. It is kept as the documented teardown for the service and for manual
# use; do not rely on it running automatically.
if [ -x /usr/local/bin/pia-pf-firewall.sh ]; then
  /usr/local/bin/pia-pf-firewall.sh remove || true
fi

# Clean up temporary files
rm -f /tmp/pia_forwarded_port /tmp/pia_token
log "PIA port forwarding cleanup complete"
