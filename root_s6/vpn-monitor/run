#!/command/with-contenv bash
# shellcheck shell=bash
# VPN Monitor - Enhanced monitoring service with kill switch enforcement
# Monitors VPN connection health and stops Transmission if VPN fails
# Auto-restart with cooldown, max attempts, and webhook notifications

set -e

# Configuration from environment variables with defaults
VPN_CHECK_INTERVAL=${VPN_CHECK_INTERVAL:-30}  # Seconds between checks
VPN_MAX_FAILURES=${VPN_MAX_FAILURES:-3}       # Max failures before action
VPN_INITIAL_DELAY=${VPN_INITIAL_DELAY:-15}    # Seconds to wait after VPN setup before monitoring
CHECK_DNS=${CHECK_DNS:-true}                  # Enable DNS resolution testing
CHECK_EXTERNAL_IP=${CHECK_EXTERNAL_IP:-true}  # Check external IP through VPN
AUTO_RESTART_VPN=${AUTO_RESTART_VPN:-false}   # Auto-restart VPN on failure
# Seconds to wait for initial VPN setup before reporting that something is wrong and
# showing vpn-setup.sh's own log. vpn-setup.sh has two sequential 60s timeouts of its
# own (the OpenVPN up script, then the interface getting an IP), so a legitimately slow
# start can take a little over two minutes; the default sits just past that.
VPN_SETUP_WAIT_WARN_SECONDS=${VPN_SETUP_WAIT_WARN_SECONDS:-150}

# Auto-restart configuration
RESTART_COOLDOWN_SECONDS=${RESTART_COOLDOWN_SECONDS:-300}  # 5 min between attempts
MAX_RESTART_ATTEMPTS=${MAX_RESTART_ATTEMPTS:-3}             # Give up after this many
NOTIFICATION_WEBHOOK_URL=${NOTIFICATION_WEBHOOK_URL:-}      # Optional webhook
# What "give up" means. true: stop the whole container with a non-zero exit code once
# MAX_RESTART_ATTEMPTS is used up, so Docker's restart policy or Kubernetes starts it
# again with fresh state. false: stay up with the kill switch engaged and wait for a
# human, which is what every release before v4.1.3-r2 did - and with the web UI still
# answering, nothing outside the container noticed for 38 hours.
EXIT_ON_MAX_RESTARTS=${EXIT_ON_MAX_RESTARTS:-true}
# s6-overlay v3: the container exits with the code in this file once halt runs.
S6_EXITCODE_FILE=${S6_EXITCODE_FILE:-/run/s6-linux-init-container-results/exitcode}
S6_HALT=${S6_HALT:-/run/s6/basedir/bin/halt}
MAX_RESTARTS_EXIT_CODE=1

# PIA port forwarding. The keepalive is a background loop started by pia-port-forward.sh.
# It exits when a bind fails (which it will once the tunnel has been down for a while),
# and nothing else ever restarted it, so the monitor watches for that.
PIA_PORT_FORWARD=${PIA_PORT_FORWARD:-false}
PF_RESTART_COOLDOWN_SECONDS=${PF_RESTART_COOLDOWN_SECONDS:-900}
PIA_PF_SCRIPT=${PIA_PF_SCRIPT:-/usr/local/bin/pia-port-forward.sh}
VPN_SETUP_SCRIPT=${VPN_SETUP_SCRIPT:-/etc/cont-init.d/50-vpn-setup}

# File paths
VPN_INTERFACE_FILE="/tmp/vpn_interface_name"
VPN_SETUP_COMPLETE="/tmp/vpn_setup_complete"
VPN_SETUP_LOG="/tmp/vpn-setup.log"
EXTERNAL_IP_FILE="/tmp/last_external_ip"
VPN_STATUS_FILE="/tmp/vpn_status"

# Auto-restart state files
LAST_RESTART_FILE="/tmp/last_vpn_restart"
RESTART_COUNT_FILE="/tmp/vpn_restart_count"
RESTART_LOG="/config/vpn-auto-restart.log"

# Result of the last tunnel probe, for the unprivileged metrics server. Same key=integer
# format as /tmp/pia_pf_state. Reset at container start by 05-reset-vpn-monitor-state.
VPN_TUNNEL_STATE_FILE=${VPN_TUNNEL_STATE_FILE:-/tmp/vpn_tunnel_state}
PIA_KEEPALIVE_PID_FILE="/tmp/pia_keepalive_pid"
LAST_PF_RESTART_FILE="/tmp/last_pf_restart"

# State tracking
FAILURE_COUNT=0
TRANSMISSION_WAS_RUNNING=false
# s6-overlay v3 supervises Transmission here. The v2 path this used to hard-code,
# /var/run/s6/services/transmission, does not exist, so s6-svc failed silently and
# Transmission was never stopped.
TRANSMISSION_SERVICE_DIRS=${TRANSMISSION_SERVICE_DIRS:-"/run/service/svc-transmission /var/run/s6/services/transmission"}
LAST_VPN_CHECK=$(date +%s)
CONSECUTIVE_HEALTHY=0
HEALTHY_CHECKS_TO_RESET=5  # Reset restart counter after this many consecutive healthy checks

log() {
    echo "[VPN-MONITOR] $(date '+%Y-%m-%d %H:%M:%S') $*"
}

# Same tunnel probe as /root/healthcheck.sh: HEALTH_CHECK_HOST, then
# HEALTH_CHECK_HOST_FALLBACK, three packets each.
probe_warn() { log "WARNING: $*"; }
VPN_PROBE_LIB=${VPN_PROBE_LIB:-/usr/local/bin/vpn-probe.sh}
# shellcheck source=root/vpn-probe.sh
. "$VPN_PROBE_LIB"

# Every OpenVPN remote gets a kill switch exception, not just the first.
remote_log() { log "$*"; }
VPN_REMOTES_LIB=${VPN_REMOTES_LIB:-/usr/local/bin/vpn-remotes.sh}
# shellcheck source=root/vpn-remotes.sh
. "$VPN_REMOTES_LIB"

log_restart() {
    local message
    message="[$(date '+%Y-%m-%d %H:%M:%S')] $*"
    echo "$message" >> "$RESTART_LOG" 2>/dev/null || true
    log "$*"
}

check_cooldown() {
    local current_time
    current_time=$(date +%s)

    if [ -f "$LAST_RESTART_FILE" ]; then
        local last_restart
        last_restart=$(cat "$LAST_RESTART_FILE")
        local time_diff=$((current_time - last_restart))

        if [ "$time_diff" -lt "$RESTART_COOLDOWN_SECONDS" ]; then
            local remaining=$((RESTART_COOLDOWN_SECONDS - time_diff))
            log "Restart in cooldown period (${remaining}s remaining)"
            return 1
        fi
    fi

    return 0
}

get_restart_count() {
    if [ -f "$RESTART_COUNT_FILE" ]; then
        cat "$RESTART_COUNT_FILE"
    else
        echo "0"
    fi
}

increment_restart_count() {
    local current_count
    current_count=$(get_restart_count)
    current_count=$((current_count + 1))
    echo "$current_count" > "$RESTART_COUNT_FILE"
    echo "$current_count"
}

reset_restart_count() {
    echo "0" > "$RESTART_COUNT_FILE"
    rm -f "$LAST_RESTART_FILE"
}

# Does traffic actually pass through the tunnel? An interface that is UP with an address
# is not enough: during the 2026-09-22 outage tun0 kept 10.25.18.69 for 38 hours while
# nothing got through it. Sets TUNNEL_FAILURE to a short reason on failure.
check_tunnel() {
    local vpn_if="$1"
    TUNNEL_FAILURE=""

    if ! ip link show "$vpn_if" 2>/dev/null | grep -q "state UP\|state UNKNOWN"; then
        TUNNEL_FAILURE="interface $vpn_if is not UP"
        return 1
    fi
    if ! ip addr show "$vpn_if" 2>/dev/null | grep -q "inet "; then
        TUNNEL_FAILURE="interface $vpn_if has no IP address"
        return 1
    fi
    if ! vpn_probe_tunnel "$vpn_if" >/dev/null; then
        TUNNEL_FAILURE="no reply through $vpn_if from $HEALTH_CHECK_HOST${HEALTH_CHECK_HOST_FALLBACK:+ or $HEALTH_CHECK_HOST_FALLBACK}"
        return 1
    fi
    return 0
}

# Publish the last probe result. The metrics server runs as an unprivileged user and
# cannot ping through the tunnel itself, so it reports this file as
# transmissionvpn_vpn_connected, and treats a stale file as not connected.
publish_tunnel_state() {
    local connected="$1"
    local tmp="${VPN_TUNNEL_STATE_FILE}.tmp"
    {
        echo "connected=$connected"
        echo "updated=$(date +%s)"
        echo "failures=$FAILURE_COUNT"
        echo "restarts=$(get_restart_count)"
        echo "max_restarts=$MAX_RESTART_ATTEMPTS"
    } > "$tmp" 2>/dev/null && mv -f "$tmp" "$VPN_TUNNEL_STATE_FILE" 2>/dev/null || true
}

# Block until s6 tears the container down. Split out so tests can replace it.
wait_for_shutdown() {
    exec sleep infinity
}

# Stop the whole container, not just this service. If this script merely exited, s6
# would restart it into the same counter file and the same dead tunnel; halting lets the
# orchestrator start a new container, which re-runs VPN setup and PIA port forwarding
# from scratch (05-reset-vpn-monitor-state clears the counter if the same container is
# restarted in place).
exit_container_for_restart() {
    log_restart "ERROR: VPN still down after $MAX_RESTART_ATTEMPTS restart attempts. Stopping the container (exit code $MAX_RESTARTS_EXIT_CODE) so it is restarted with fresh state. Set EXIT_ON_MAX_RESTARTS=false to keep it running instead."
    send_notification "vpn_restart_exhausted" "Maximum VPN restart attempts exceeded - stopping container for restart"
    publish_tunnel_state 0

    if ! { mkdir -p "$(dirname "$S6_EXITCODE_FILE")" && echo "$MAX_RESTARTS_EXIT_CODE" > "$S6_EXITCODE_FILE"; } 2>/dev/null; then
        log "WARNING: Could not write $S6_EXITCODE_FILE; the container may exit 0"
    fi

    if [ -x "$S6_HALT" ]; then
        "$S6_HALT" || log "ERROR: $S6_HALT failed (exit $?)"
    else
        log "ERROR: $S6_HALT not found; signalling PID 1 instead"
        kill -TERM 1 2>/dev/null || log "ERROR: Could not signal PID 1"
    fi
    wait_for_shutdown
}

# Kill any old keepalive and run PIA port forwarding again, in the background so the
# monitor keeps checking. pia-port-forward.sh fetches a new signature from whichever
# gateway the tunnel is on now, re-applies the firewall rules, sets Transmission's peer
# port and starts a fresh keepalive.
restart_port_forwarding() {
    local reason="$1"
    local old_pid

    old_pid=$(cat "$PIA_KEEPALIVE_PID_FILE" 2>/dev/null || true)
    if [ -n "$old_pid" ] && kill -0 "$old_pid" 2>/dev/null; then
        kill "$old_pid" 2>/dev/null || true
    fi
    rm -f "$PIA_KEEPALIVE_PID_FILE"
    date +%s > "$LAST_PF_RESTART_FILE"

    log "Restarting PIA port forwarding: $reason"
    "$PIA_PF_SCRIPT" &
}

# Called while the tunnel is healthy. Restarts PIA port forwarding if its keepalive
# has died, unless a run is already in progress or one was started recently.
ensure_port_forwarding() {
    [ "${PIA_PORT_FORWARD,,}" = "true" ] || return 0

    local pid
    pid=$(cat "$PIA_KEEPALIVE_PID_FILE" 2>/dev/null || true)
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
        return 0
    fi

    # Any other pia-port-forward process is a setup run still in progress: the s6
    # oneshot at startup (its run script, then the exec'd pia-port-forward.sh), or one
    # started below. Leave it alone rather than racing it for a second signature.
    if pgrep -f "pia-port-forward" 2>/dev/null | grep -qvx "${pid:-none}"; then
        return 0
    fi

    if [ -f "$LAST_PF_RESTART_FILE" ]; then
        local last
        last=$(cat "$LAST_PF_RESTART_FILE" 2>/dev/null || true)
        case "$last" in ''|*[!0-9]*) last=0 ;; esac
        if [ $(( $(date +%s) - last )) -lt "$PF_RESTART_COOLDOWN_SECONDS" ]; then
            return 0
        fi
    fi

    restart_port_forwarding "keepalive is not running"
}

send_notification() {
    local event="$1"
    local message="$2"

    if [ -z "$NOTIFICATION_WEBHOOK_URL" ]; then
        return 0
    fi

    local payload
    payload="{\"event\":\"$event\",\"message\":\"$message\",\"timestamp\":\"$(date -Iseconds 2>/dev/null || date '+%Y-%m-%dT%H:%M:%S')\",\"container\":\"transmissionvpn\"}"

    curl -X POST \
         -H "Content-Type: application/json" \
         -d "$payload" \
         --max-time 10 \
         --silent \
         "$NOTIFICATION_WEBHOOK_URL" >/dev/null 2>&1 || true
}

check_dns_resolution() {
    if [ "${CHECK_DNS,,}" != "true" ]; then
        return 0
    fi

    # Test DNS resolution through VPN
    if nslookup google.com 1.1.1.1 >/dev/null 2>&1; then
        return 0
    else
        log "WARNING: DNS resolution check failed"
        return 1
    fi
}

check_external_ip() {
    if [ "${CHECK_EXTERNAL_IP,,}" != "true" ]; then
        return 0
    fi

    # Get current external IP
    CURRENT_IP=$(curl -s --max-time 10 --interface "$1" ifconfig.me 2>/dev/null || echo "FAILED")

    if [ "$CURRENT_IP" = "FAILED" ]; then
        log "WARNING: Failed to get external IP"
        return 1
    fi

    # Check if IP has changed unexpectedly (potential leak)
    if [ -f "$EXTERNAL_IP_FILE" ]; then
        PREVIOUS_IP=$(cat "$EXTERNAL_IP_FILE")
        if [ "$PREVIOUS_IP" != "$CURRENT_IP" ] && [ -n "$PREVIOUS_IP" ]; then
            log "WARNING: External IP changed from $PREVIOUS_IP to $CURRENT_IP"
        fi
    fi

    echo "$CURRENT_IP" > "$EXTERNAL_IP_FILE"
    return 0
}

enforce_killswitch() {
    local vpn_if="$1"

    log "Enforcing kill switch - blocking ALL non-VPN traffic"

    # Clear existing OUTPUT rules and apply strict kill switch
    iptables -F OUTPUT
    iptables -A OUTPUT -o lo -j ACCEPT
    # On eth0, established traffic only as replies to inbound connections. A peer
    # connection opened through the tunnel stays ESTABLISHED after the tunnel routes
    # are gone and would otherwise follow the default route out of eth0.
    iptables -A OUTPUT ! -o eth0 -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
    iptables -A OUTPUT -o eth0 -m conntrack --ctstate ESTABLISHED,RELATED --ctdir REPLY -j ACCEPT

    # Allow Transmission UI access
    iptables -A OUTPUT -o eth0 -p tcp --sport 9091 -j ACCEPT

    # Allow VPN server traffic so OpenVPN/WireGuard can reconnect
    if [ "${VPN_CLIENT,,}" = "openvpn" ]; then
        local ovpn_config="${VPN_CONFIG:-/config/openvpn/*.ovpn}"
        # VPN_CONFIG may be a glob pattern, so the expansion here is deliberate.
        # shellcheck disable=SC2012,SC2086
        ovpn_config=$(ls $ovpn_config 2>/dev/null | head -1)
        if [ -f "$ovpn_config" ]; then
            vpn_allow_remotes "$ovpn_config" append
        fi
    elif [ "${VPN_CLIENT,,}" = "wireguard" ]; then
        local wg_config="${WG_CONFIG:-/config/wireguard/wg0.conf}"
        if [ -f "$wg_config" ]; then
            local wg_endpoint wg_server wg_port
            wg_endpoint=$(grep '^Endpoint' "$wg_config" | head -1 | awk -F'=' '{print $2}' | tr -d ' ')
            wg_server=$(echo "$wg_endpoint" | cut -d: -f1)
            wg_port=$(echo "$wg_endpoint" | cut -d: -f2)
            if [ -n "$wg_server" ] && [ -n "$wg_port" ]; then
                local resolved_ip
                resolved_ip=$(getent hosts "$wg_server" 2>/dev/null | awk '{print $1}' | head -1)
                [ -z "$resolved_ip" ] && resolved_ip="$wg_server"
                log "Kill switch: allowing WireGuard server traffic to $resolved_ip:$wg_port/udp"
                iptables -A OUTPUT -o eth0 -d "$resolved_ip" -p udp --dport "$wg_port" -j ACCEPT
            fi
        fi
    fi

    # If VPN interface exists, allow traffic through it
    if [ -n "$vpn_if" ] && ip link show "$vpn_if" >/dev/null 2>&1; then
        iptables -A OUTPUT -o "$vpn_if" -j ACCEPT
    fi

    # Block everything else
    iptables -A OUTPUT -j DROP

    # Also reinforce DNS leak prevention
    iptables -I OUTPUT 1 -p udp --dport 53 ! -o "$vpn_if" -j DROP
    iptables -I OUTPUT 1 -p tcp --dport 53 ! -o "$vpn_if" -j DROP

    log "Kill switch enforced - all non-VPN traffic blocked (VPN server exempt)"
}

transmission_service_dir() {
    local dir
    for dir in $TRANSMISSION_SERVICE_DIRS; do
        if [ -d "$dir/supervise" ]; then
            echo "$dir"
            return 0
        fi
    done
    return 1
}

stop_transmission() {
    local svc_dir
    if pgrep transmission-daemon >/dev/null 2>&1; then
        TRANSMISSION_WAS_RUNNING=true
        log "CRITICAL: Stopping Transmission to prevent IP leaks"

        # Take the service down through s6 first, so the supervisor does not simply
        # start it again, and wait up to 15s for it to exit.
        if command -v s6-svc >/dev/null 2>&1 && svc_dir=$(transmission_service_dir); then
            s6-svc -wD -T 15000 -d "$svc_dir" 2>/dev/null || log "WARNING: s6-svc -d $svc_dir did not confirm the stop"
        fi
        # Whatever happened above, make sure the daemon is really gone.
        if pgrep transmission-daemon >/dev/null 2>&1; then
            pkill -TERM transmission-daemon 2>/dev/null || true
            sleep 2
            pkill -KILL transmission-daemon 2>/dev/null || true
        fi
        if pgrep transmission-daemon >/dev/null 2>&1; then
            log "ERROR: transmission-daemon is still running after stop"
        fi

        echo "stopped" > "$VPN_STATUS_FILE"
    fi
}

restart_transmission() {
    local svc_dir
    if [ "$TRANSMISSION_WAS_RUNNING" = "true" ]; then
        log "Restarting Transmission after VPN recovery"

        if command -v s6-svc >/dev/null 2>&1 && svc_dir=$(transmission_service_dir); then
            s6-svc -u "$svc_dir" 2>/dev/null || log "WARNING: s6-svc -u $svc_dir failed"
        else
            /usr/bin/transmission-daemon --config-dir /config &
        fi

        TRANSMISSION_WAS_RUNNING=false
        echo "running" > "$VPN_STATUS_FILE"
    fi
}

attempt_vpn_restart() {
    if [ "${AUTO_RESTART_VPN,,}" != "true" ]; then
        return 1
    fi

    # Check cooldown period
    if ! check_cooldown; then
        return 1
    fi

    # Check restart count
    local restart_count
    restart_count=$(get_restart_count)
    if [ "$restart_count" -ge "$MAX_RESTART_ATTEMPTS" ]; then
        if [ "${EXIT_ON_MAX_RESTARTS,,}" = "true" ]; then
            exit_container_for_restart
        fi
        log_restart "ERROR: Maximum restart attempts ($MAX_RESTART_ATTEMPTS) exceeded - manual intervention required (EXIT_ON_MAX_RESTARTS=false)"
        send_notification "vpn_restart_exhausted" "Maximum VPN restart attempts exceeded"
        return 1
    fi

    # Increment count and record time
    restart_count=$(increment_restart_count)
    date +%s > "$LAST_RESTART_FILE"

    log_restart "Attempting VPN restart (attempt $restart_count/$MAX_RESTART_ATTEMPTS)"
    send_notification "vpn_restart_attempt" "Attempting VPN restart ($restart_count/$MAX_RESTART_ATTEMPTS)"

    # Temporarily allow VPN server traffic through killswitch for reconnection
    local ovpn_config="${VPN_CONFIG:-/config/openvpn/*.ovpn}"
    # VPN_CONFIG may be a glob pattern, so the expansion here is deliberate.
    # shellcheck disable=SC2012,SC2086
    ovpn_config=$(ls $ovpn_config 2>/dev/null | head -1)
    if [ "${VPN_CLIENT,,}" = "openvpn" ] && [ -f "$ovpn_config" ]; then
        log_restart "Adding temporary firewall exceptions for the OpenVPN remotes in $ovpn_config"
        vpn_allow_remotes "$ovpn_config" insert
    elif [ "${VPN_CLIENT,,}" = "wireguard" ]; then
        local wg_config="${WG_CONFIG:-/config/wireguard/wg0.conf}"
        if [ -f "$wg_config" ]; then
            local wg_endpoint wg_server wg_port
            wg_endpoint=$(grep '^Endpoint' "$wg_config" | head -1 | awk -F'=' '{print $2}' | tr -d ' ')
            wg_server=$(echo "$wg_endpoint" | cut -d: -f1)
            wg_port=$(echo "$wg_endpoint" | cut -d: -f2)
            if [ -n "$wg_server" ] && [ -n "$wg_port" ]; then
                log_restart "Adding temporary firewall exception for WireGuard server $wg_server:$wg_port"
                iptables -I OUTPUT 1 -o eth0 -d "$wg_server" -p udp --dport "$wg_port" -j ACCEPT
            fi
        fi
    fi

    # Kill existing VPN processes
    if [ "${VPN_CLIENT,,}" = "wireguard" ]; then
        wg-quick down "$VPN_INTERFACE" 2>/dev/null || true
    elif [ "${VPN_CLIENT,,}" = "openvpn" ]; then
        pkill openvpn 2>/dev/null || true
    fi

    sleep 5

    # Re-run VPN setup script
    local restart_success=false
    if "$VPN_SETUP_SCRIPT" 2>/dev/null; then
        restart_success=true
    fi

    if [ "$restart_success" = "true" ]; then
        # Wait for VPN to stabilize and verify
        sleep 10

        # Re-read VPN interface name (may have changed)
        if [ -f "$VPN_INTERFACE_FILE" ]; then
            VPN_INTERFACE=$(cat "$VPN_INTERFACE_FILE")
        fi

        # Verify traffic passes, not just that the interface came back: a tunnel can
        # come up with an address and still carry nothing (a compress mismatch did
        # exactly that on 2026-09-22), and counting that as a success would reset
        # the failure count and hide the outage.
        if check_tunnel "$VPN_INTERFACE"; then
            log_restart "VPN restart successful - traffic passes through $VPN_INTERFACE"
            send_notification "vpn_restart_success" "VPN successfully restarted"
            # The old keepalive is bound to the previous session's gateway and signature.
            if [ "${PIA_PORT_FORWARD,,}" = "true" ]; then
                restart_port_forwarding "VPN was restarted"
            fi
            return 0
        else
            log_restart "VPN restart completed but the tunnel is not usable: $TUNNEL_FAILURE"
            send_notification "vpn_restart_failed" "VPN restart completed but tunnel check failed: $TUNNEL_FAILURE"
            return 1
        fi
    else
        log_restart "VPN setup script failed"
        send_notification "vpn_restart_failed" "VPN setup script returned error"
        return 1
    fi
}

# Wait for initial VPN setup.
#
# vpn-setup.sh runs as a cont-init script and touches $VPN_SETUP_COMPLETE when it
# finishes. If it aborts - a VPN_CONFIG the container cannot see, credentials the
# provider rejects, a tunnel that never gets an IP - that flag is never written and this
# wait never ends. It used to do that in silence, repeating one line every five seconds
# with no hint that anything had gone wrong or where to look: issues #33 and #36 are both
# pages of exactly that. vpn-setup.sh records why it stopped in $VPN_SETUP_LOG, so once
# the wait has clearly overrun, say so, show that log, and stop flooding this one.
wait_for_vpn_setup() {
    local elapsed=0
    local warned=false
    local line

    while [ ! -f "$VPN_SETUP_COMPLETE" ]; do
        if [ "$warned" = false ] && [ "$elapsed" -ge "$VPN_SETUP_WAIT_WARN_SECONDS" ]; then
            warned=true
            log "WARNING: VPN setup has not completed after ${elapsed}s - it should have by now."
            log "If vpn-setup.sh failed, its own output says why. Last lines of $VPN_SETUP_LOG:"
            if [ -s "$VPN_SETUP_LOG" ]; then
                tail -n 25 "$VPN_SETUP_LOG" | while IFS= read -r line; do
                    log "  | $line"
                done
            elif [ -f "$VPN_SETUP_LOG" ]; then
                log "  | ($VPN_SETUP_LOG is empty)"
            else
                log "  | ($VPN_SETUP_LOG does not exist - vpn-setup.sh has not started)"
            fi
            log "No traffic leaves this container until setup succeeds. Fix the error above"
            log "and restart the container. Further waiting messages every 60s, not every 5s."
        fi

        if [ "$warned" = true ]; then
            log "Still waiting for VPN setup (${elapsed}s elapsed) - see $VPN_SETUP_LOG"
            sleep 60
            elapsed=$((elapsed + 60))
        else
            log "Waiting for initial VPN setup to complete..."
            sleep 5
            elapsed=$((elapsed + 5))
        fi
    done
}

log "Starting VPN monitor service (interval: ${VPN_CHECK_INTERVAL}s, max failures: ${VPN_MAX_FAILURES})"
if [ "${AUTO_RESTART_VPN,,}" = "true" ]; then
    log "Auto-restart enabled (cooldown: ${RESTART_COOLDOWN_SECONDS}s, max attempts: ${MAX_RESTART_ATTEMPTS})"
fi
wait_for_vpn_setup
log "VPN setup complete, waiting ${VPN_INITIAL_DELAY}s for routes to stabilize..."
sleep "$VPN_INITIAL_DELAY"

log "VPN monitoring started - protecting against IP leaks"
echo "running" > "$VPN_STATUS_FILE"

# Main monitoring loop
while true; do
    # Get VPN interface name
    if [ -f "$VPN_INTERFACE_FILE" ]; then
        VPN_INTERFACE=$(cat "$VPN_INTERFACE_FILE")
    else
        log "ERROR: VPN interface file not found"
        publish_tunnel_state 0
        stop_transmission
        enforce_killswitch ""
        sleep "$VPN_CHECK_INTERVAL"
        continue
    fi

    # Comprehensive VPN health checks
    VPN_HEALTHY=true

    # Checks 1-3: interface UP, has an address, and traffic passes through it.
    # This result alone is what gets published as "connected"; the DNS and
    # external-IP checks below are about the path beyond the tunnel.
    TUNNEL_OK=1
    if ! check_tunnel "$VPN_INTERFACE"; then
        log "ERROR: VPN tunnel check failed: $TUNNEL_FAILURE"
        VPN_HEALTHY=false
        TUNNEL_OK=0
    fi

    # Check 4: DNS resolution (optional)
    if [ "$VPN_HEALTHY" = "true" ] && [ "${CHECK_DNS,,}" = "true" ]; then
        if ! check_dns_resolution; then
            VPN_HEALTHY=false
        fi
    fi

    # Check 5: External IP verification (optional)
    if [ "$VPN_HEALTHY" = "true" ] && [ "${CHECK_EXTERNAL_IP,,}" = "true" ]; then
        if ! check_external_ip "$VPN_INTERFACE"; then
            VPN_HEALTHY=false
        fi
    fi

    # Handle VPN health status
    if [ "$VPN_HEALTHY" = "true" ]; then
        # VPN is healthy
        if [ $FAILURE_COUNT -gt 0 ]; then
            log "VPN connectivity restored after $FAILURE_COUNT failures"
            restart_transmission
        fi
        FAILURE_COUNT=0

        # Track consecutive healthy checks to reset restart counter
        CONSECUTIVE_HEALTHY=$((CONSECUTIVE_HEALTHY + 1))
        if [ "$CONSECUTIVE_HEALTHY" -ge "$HEALTHY_CHECKS_TO_RESET" ]; then
            current_restart_count=$(get_restart_count)
            if [ "$current_restart_count" -gt 0 ]; then
                log "VPN stable for $CONSECUTIVE_HEALTHY checks, resetting restart counter"
                reset_restart_count
            fi
            CONSECUTIVE_HEALTHY=0
        fi
        publish_tunnel_state "$TUNNEL_OK"

        ensure_port_forwarding
    else
        # VPN is unhealthy
        FAILURE_COUNT=$((FAILURE_COUNT + 1))
        CONSECUTIVE_HEALTHY=0
        log "VPN health check failed ($FAILURE_COUNT/$VPN_MAX_FAILURES)"
        # Published before any restart attempt, which can block for minutes.
        publish_tunnel_state "$TUNNEL_OK"

        if [ "$FAILURE_COUNT" -ge "$VPN_MAX_FAILURES" ]; then
            log "CRITICAL: VPN failed after $VPN_MAX_FAILURES consecutive checks"

            # Stop Transmission immediately
            stop_transmission

            # Enforce strict kill switch
            enforce_killswitch "$VPN_INTERFACE"

            # Attempt VPN restart if enabled
            if [ "${AUTO_RESTART_VPN,,}" = "true" ]; then
                if attempt_vpn_restart; then
                    log "VPN restart successful, waiting ${VPN_INITIAL_DELAY}s for routes to stabilize..."
                    sleep "$VPN_INITIAL_DELAY"
                    log "Resuming monitoring"
                    FAILURE_COUNT=0
                else
                    log "VPN restart failed or skipped"
                fi
            else
                log "Auto-restart disabled - manual intervention required"
            fi
        fi
    fi

    # Log status periodically
    if [ $(($(date +%s) - LAST_VPN_CHECK)) -ge 300 ]; then
        if [ "$VPN_HEALTHY" = "true" ]; then
            log "Status: VPN healthy, Transmission protected"
        else
            restart_count=$(get_restart_count)
            log "Status: VPN unhealthy, Transmission stopped, kill switch active (restarts: $restart_count/$MAX_RESTART_ATTEMPTS)"
        fi
        LAST_VPN_CHECK=$(date +%s)
    fi

    sleep "$VPN_CHECK_INTERVAL"
done
